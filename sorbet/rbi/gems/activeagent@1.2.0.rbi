# Normalizes token usage statistics across AI providers.
#
# Providers return usage data in different formats with different field names.
# This model normalizes them into a consistent structure, automatically calculating
# +total_tokens+ if not provided.
#
# @example Accessing normalized usage data
#   usage = response.normalized_usage
#   usage.input_tokens      #=> 100
#   usage.output_tokens     #=> 25
#   usage.total_tokens      #=> 125
#   usage.cached_tokens     #=> 20 (if available)
#
# @example Provider-specific details
#   usage.provider_details  #=> { "completion_tokens_details" => {...}, ... }
#   usage.duration_ms       #=> 5000 (for Ollama)
#   usage.service_tier      #=> "standard" (for Anthropic)
#
# @see https://platform.openai.com/docs/api-reference/chat/object OpenAI Chat Completion
# @see https://docs.anthropic.com/en/api/messages Anthropic Messages API
# @see https://github.com/ollama/ollama/blob/main/docs/api.md Ollama API
#
# pkg:gem/activeagent#lib/active_agent/providers/common/usage.rb:29
class ActiveAgent::Providers::Common::Usage < ::ActiveAgent::Providers::Common::BaseModel
  # Automatically calculates total_tokens if not provided.
  #
  # @param attributes [Hash]
  # @option attributes [Integer] :input_tokens
  # @option attributes [Integer] :output_tokens
  # @option attributes [Integer] :total_tokens (calculated if not provided)
  # @option attributes [Integer] :cached_tokens
  # @option attributes [Integer] :reasoning_tokens
  # @option attributes [Integer] :audio_tokens
  # @option attributes [Integer] :cache_creation_tokens
  # @option attributes [String] :service_tier
  # @option attributes [Integer] :duration_ms
  # @option attributes [Hash] :provider_details
  #
  # pkg:gem/activeagent#lib/active_agent/providers/common/usage.rb:123
  def initialize(attributes = T.unsafe(nil)); end

  # Sums all token counts from two Usage objects.
  #
  # @param other [Usage]
  # @return [Usage]
  #
  # @example
  #   usage1 = Usage.new(input_tokens: 100, output_tokens: 50)
  #   usage2 = Usage.new(input_tokens: 75, output_tokens: 25)
  #   combined = usage1 + usage2
  #   combined.input_tokens  #=> 175
  #   combined.output_tokens #=> 75
  #   combined.total_tokens  #=> 250
  #
  # pkg:gem/activeagent#lib/active_agent/providers/common/usage.rb:141
  def +(other); end

  private

  # @param a [Integer, nil]
  # @param b [Integer, nil]
  # @return [Integer, nil] nil if both inputs are nil
  #
  # pkg:gem/activeagent#lib/active_agent/providers/common/usage.rb:361
  def sum_optional(a, b); end

  class << self
    # @param tokens [Integer, nil]
    # @param duration_ns [Integer, nil]
    # @return [Float, nil]
    #
    # pkg:gem/activeagent#lib/active_agent/providers/common/usage.rb:377
    def calculate_tokens_per_second(tokens, duration_ns); end

    # @param nanoseconds [Integer, nil]
    # @return [Integer, nil]
    #
    # pkg:gem/activeagent#lib/active_agent/providers/common/usage.rb:368
    def convert_nanoseconds_to_ms(nanoseconds); end

    # Creates a Usage object from Anthropic usage data.
    #
    # @param usage_hash [Hash]
    # @return [Usage]
    #
    # @example
    #   Usage.from_anthropic({
    #     "input_tokens" => 2095,
    #     "output_tokens" => 503,
    #     "cache_read_input_tokens" => 1500,
    #     "cache_creation_input_tokens" => 2051,
    #     "service_tier" => "standard"
    #   })
    #
    # pkg:gem/activeagent#lib/active_agent/providers/common/usage.rb:257
    def from_anthropic(usage_hash); end

    # Creates a Usage object from Ollama usage data.
    #
    # @param usage_hash [Hash]
    # @return [Usage]
    #
    # @example
    #   Usage.from_ollama({
    #     "prompt_eval_count" => 50,
    #     "eval_count" => 25,
    #     "total_duration" => 5000000000,
    #     "load_duration" => 1000000000
    #   })
    #
    # pkg:gem/activeagent#lib/active_agent/providers/common/usage.rb:284
    def from_ollama(usage_hash); end

    # Creates a Usage object from OpenAI Chat Completion usage data.
    #
    # @param usage_hash [Hash]
    # @return [Usage]
    #
    # @example
    #   Usage.from_openai_chat({
    #     "prompt_tokens" => 100,
    #     "completion_tokens" => 25,
    #     "total_tokens" => 125,
    #     "prompt_tokens_details" => { "cached_tokens" => 20 },
    #     "completion_tokens_details" => { "reasoning_tokens" => 3 }
    #   })
    #
    # pkg:gem/activeagent#lib/active_agent/providers/common/usage.rb:168
    def from_openai_chat(usage_hash); end

    # Creates a Usage object from OpenAI Embedding API usage data.
    #
    # @param usage_hash [Hash]
    # @return [Usage]
    #
    # @example
    #   Usage.from_openai_embedding({
    #     "prompt_tokens" => 8,
    #     "total_tokens" => 8
    #   })
    #
    # pkg:gem/activeagent#lib/active_agent/providers/common/usage.rb:201
    def from_openai_embedding(usage_hash); end

    # Creates a Usage object from OpenAI Responses API usage data.
    #
    # @param usage_hash [Hash]
    # @return [Usage]
    #
    # @example
    #   Usage.from_openai_responses({
    #     "input_tokens" => 150,
    #     "output_tokens" => 75,
    #     "total_tokens" => 225,
    #     "input_tokens_details" => { "cached_tokens" => 50 },
    #     "output_tokens_details" => { "reasoning_tokens" => 10 }
    #   })
    #
    # pkg:gem/activeagent#lib/active_agent/providers/common/usage.rb:227
    def from_openai_responses(usage_hash); end

    # Creates a Usage object from OpenRouter usage data.
    #
    # OpenRouter uses the same format as OpenAI Chat Completion.
    #
    # @param usage_hash [Hash]
    # @return [Usage]
    #
    # @example
    #   Usage.from_openrouter({
    #     "prompt_tokens" => 14,
    #     "completion_tokens" => 4,
    #     "total_tokens" => 18
    #   })
    #
    # pkg:gem/activeagent#lib/active_agent/providers/common/usage.rb:315
    def from_openrouter(usage_hash); end

    # Auto-detects the provider format and creates a normalized Usage object.
    #
    # @note Detection is based on hash structure rather than native gem types
    #   because we cannot force-load all provider gems. This allows the framework
    #   to work with only the gems the user has installed.
    #
    # @param usage_hash [Hash]
    # @return [Usage, nil]
    #
    # @example
    #   Usage.from_provider_usage(some_usage_hash)
    #
    # pkg:gem/activeagent#lib/active_agent/providers/common/usage.rb:330
    def from_provider_usage(usage_hash); end

    private

    # pkg:gem/activeagent#lib/active_agent/providers/common/usage.rb:29
    def __class_attr__validators; end

    # pkg:gem/activeagent#lib/active_agent/providers/common/usage.rb:29
    def __class_attr__validators=(new_value); end
  end
end

# Typed provider failures, normalized across vendor SDKs.
#
# Every vendor raises its own exception classes for the same underlying
# conditions (rate limits, context overflows, content filters, outages),
# which makes retry/backoff/fallback policy impossible to express
# portably. The taxonomy classifies vendor errors into a small set of
# framework types — the original exception is preserved as +#cause+, so
# nothing is lost.
#
# @example Portable retry policy
#   rescue_from ActiveAgent::Providers::Errors::RateLimited do |error|
#     retry_job wait: 30.seconds
#   end
#
# @example Fallback on outage
#   rescue_from ActiveAgent::Providers::Errors::ServiceUnavailable do |error|
#     FallbackAgent.with(params).ask.generate_later
#   end
#
# pkg:gem/activeagent#lib/active_agent/providers/errors.rb:23
module ActiveAgent::Providers::Errors; end

# Invalid, expired, or unauthorized credentials (401/403).
#
# pkg:gem/activeagent#lib/active_agent/providers/errors.rb:47
class ActiveAgent::Providers::Errors::AuthenticationFailed < ::ActiveAgent::Providers::Errors::ProviderError; end

# The vendor's safety layer refused the request or response.
#
# pkg:gem/activeagent#lib/active_agent/providers/errors.rb:50
class ActiveAgent::Providers::Errors::ContentFiltered < ::ActiveAgent::Providers::Errors::ProviderError; end

# The prompt exceeded the model's context window. Not retryable
# without shrinking the input.
#
# pkg:gem/activeagent#lib/active_agent/providers/errors.rb:44
class ActiveAgent::Providers::Errors::ContextLengthExceeded < ::ActiveAgent::Providers::Errors::ProviderError; end

# Malformed or unsupported request the vendor rejected (400/422)
# that doesn't classify more specifically.
#
# pkg:gem/activeagent#lib/active_agent/providers/errors.rb:58
class ActiveAgent::Providers::Errors::InvalidRequest < ::ActiveAgent::Providers::Errors::ProviderError; end

# Base class for normalized provider failures.
#
# pkg:gem/activeagent#lib/active_agent/providers/errors.rb:25
class ActiveAgent::Providers::Errors::ProviderError < ::StandardError
  # pkg:gem/activeagent#lib/active_agent/providers/errors.rb:32
  def initialize(message = T.unsafe(nil), status: T.unsafe(nil), provider_tag: T.unsafe(nil)); end

  # @return [String, nil] provider tag (e.g. "Anthropic", "OpenAI::Chat")
  #
  # pkg:gem/activeagent#lib/active_agent/providers/errors.rb:30
  def provider_tag; end

  # @return [Integer, nil] HTTP status from the vendor error, when known
  #
  # pkg:gem/activeagent#lib/active_agent/providers/errors.rb:27
  def status; end
end

# 429s / vendor rate & quota limits. Retryable with backoff.
#
# pkg:gem/activeagent#lib/active_agent/providers/errors.rb:40
class ActiveAgent::Providers::Errors::RateLimited < ::ActiveAgent::Providers::Errors::ProviderError; end

# Vendor-side failure or overload (5xx, timeouts, connection drops).
# Retryable; a natural trigger for provider fallback.
#
# pkg:gem/activeagent#lib/active_agent/providers/errors.rb:54
class ActiveAgent::Providers::Errors::ServiceUnavailable < ::ActiveAgent::Providers::Errors::ProviderError; end

# Classifies vendor SDK exceptions into the taxonomy. Unrecognizable
# exceptions (including ordinary Ruby errors) pass through untouched —
# only errors that look like vendor API failures are normalized.
#
# pkg:gem/activeagent#lib/active_agent/providers/errors.rb:63
module ActiveAgent::Providers::Errors::Taxonomy
  class << self
    # @return [Class, nil]
    #
    # pkg:gem/activeagent#lib/active_agent/providers/errors.rb:109
    def classify(exception); end

    # @param exception [Exception]
    # @param provider_tag [String, nil]
    # @return [Exception] a taxonomy error, or the original exception
    #   when it doesn't classify
    #
    # pkg:gem/activeagent#lib/active_agent/providers/errors.rb:99
    def normalize(exception, provider_tag: T.unsafe(nil)); end

    # @return [Integer, nil]
    #
    # pkg:gem/activeagent#lib/active_agent/providers/errors.rb:123
    def status_of(exception); end
  end
end

# pkg:gem/activeagent#lib/active_agent/providers/errors.rb:92
ActiveAgent::Providers::Errors::Taxonomy::CONTENT_FILTER_PATTERN = T.let(T.unsafe(nil), Regexp)

# pkg:gem/activeagent#lib/active_agent/providers/errors.rb:91
ActiveAgent::Providers::Errors::Taxonomy::CONTEXT_LENGTH_PATTERN = T.let(T.unsafe(nil), Regexp)

# Vendor SDK class names (demodulized) → taxonomy class. Covers the
# official anthropic/openai gems and SDKs following their naming.
#
# pkg:gem/activeagent#lib/active_agent/providers/errors.rb:66
ActiveAgent::Providers::Errors::Taxonomy::NAME_MAP = T.let(T.unsafe(nil), Hash)

# pkg:gem/activeagent#lib/active_agent/providers/errors.rb:81
ActiveAgent::Providers::Errors::Taxonomy::STATUS_MAP = T.let(T.unsafe(nil), Hash)

# Provides exception handling for provider operations.
#
# This concern implements basic exception handling that allows agents to
# define custom error handling logic via rescue_from callbacks. The actual
# retry logic is now handled by the underlying provider gems (ruby-openai,
# anthropic-rb, etc.) which provide their own retry mechanisms.
#
# @example Using exception handler
#   class MyProvider
#     include ActiveAgent::Providers::ExceptionHandler
#
#     def call
#       with_exception_handling do
#         # API call that may fail
#       end
#     end
#   end
#
# @example Agent-level error handling
#   class MyAgent < ActiveAgent::Base
#     rescue_from SomeError do |exception|
#       # Handle the error
#     end
#   end
#
# pkg:gem/activeagent#lib/active_agent/providers/concerns/exception_handler.rb:31
module ActiveAgent::Providers::ExceptionHandler
  extend ::ActiveSupport::Concern

  # Configures instance-level exception handling.
  #
  # @param exception_handler [Proc, nil] callback for handling exceptions
  # @return [void]
  #
  # pkg:gem/activeagent#lib/active_agent/providers/concerns/exception_handler.rb:44
  def configure_exception_handler(exception_handler: T.unsafe(nil)); end

  # Bubbles up exceptions to the Agent's rescue_from if a handler is defined.
  #
  # This method delegates exception handling to the configured exception handler,
  # allowing agents to define custom error handling logic.
  #
  # @param exception [StandardError] The exception to handle
  # @return [Object, nil] Result from the exception handler, or nil if no handler
  #
  # pkg:gem/activeagent#lib/active_agent/providers/concerns/exception_handler.rb:79
  def rescue_with_handler(exception); end

  # Executes a block with exception handling.
  #
  # @yield Block to execute with exception protection
  # @return [Object] The result of the block execution
  # @raise [StandardError] Any unhandled exception from the block
  #
  # @example Basic usage
  #   with_exception_handling { api_call }
  #
  # pkg:gem/activeagent#lib/active_agent/providers/concerns/exception_handler.rb:56
  def with_exception_handling(&block); end
end

# Builds instrumentation event payloads for ActiveSupport::Notifications.
#
# Extracts request parameters and response metadata for monitoring, debugging,
# and APM integration (New Relic, DataDog, etc.).
#
# == Event Payloads
#
# Top-Level Events (overall request lifecycle):
#
# prompt.active_agent::
#   Initial: `{ model:, temperature:, max_tokens:, message_count:, has_tools:, stream: }`
#   Final: `{ usage: { input_tokens:, output_tokens:, total_tokens: }, finish_reason:, response_model:, response_id: }`
#   Note: Usage is cumulative across all API calls in multi-turn conversations
#
# embed.active_agent::
#   Initial: `{ model:, input_size:, encoding_format:, dimensions: }`
#   Final: `{ usage: { input_tokens:, total_tokens: }, embedding_count:, response_model:, response_id: }`
#
# Provider-Level Events (per API call):
#
# prompt.provider.active_agent::
#   Initial: `{ model:, temperature:, max_tokens:, message_count:, has_tools:, stream: }`
#   Final: `{ usage: { input_tokens:, output_tokens:, total_tokens: }, finish_reason:, response_model:, response_id: }`
#   Note: Usage is per individual API call
#
# embed.provider.active_agent::
#   Initial: `{ model:, input_size:, encoding_format:, dimensions: }`
#   Final: `{ usage: { input_tokens:, total_tokens: }, embedding_count:, response_model:, response_id: }`
#
# pkg:gem/activeagent#lib/active_agent/providers/concerns/instrumentation.rb:33
module ActiveAgent::Providers::Instrumentation
  extend ::ActiveSupport::Concern

  # Builds and merges payload data for prompt instrumentation events.
  #
  # Populates both request parameters and response metadata for top-level and
  # provider-level events. Usage data (tokens) is CRITICAL for APM cost tracking
  # and performance monitoring.
  #
  # @param payload [Hash] instrumentation payload to merge into
  # @param request [Request] request object with parameters
  # @param response [Common::PromptResponse] completed response with normalized data
  # @return [void]
  #
  # pkg:gem/activeagent#lib/active_agent/providers/concerns/instrumentation.rb:46
  def instrumentation_prompt_payload(payload, request, response); end

  private

  # Extract a simple hash from a provider message object or hash-like value.
  #
  # pkg:gem/activeagent#lib/active_agent/providers/concerns/instrumentation.rb:162
  def extract_message_hash(msg, is_response = T.unsafe(nil)); end

  # Builds and merges payload data for embed instrumentation events.
  #
  # Embeddings typically only report input tokens (no output tokens).
  #
  # @param payload [Hash] instrumentation payload to merge into
  # @param request [Request] request object with parameters
  # @param response [Common::EmbedResponse] completed response with normalized data
  # @return [void]
  #
  # pkg:gem/activeagent#lib/active_agent/providers/concerns/instrumentation.rb:202
  def instrumentation_embed_payload(payload, request, response); end

  # Safely attempt to call a method or lookup a key on an object. We avoid
  # probing with `respond_to?` to prevent ActiveModel attribute casting side
  # effects; instead we attempt the call and rescue failures.
  #
  # pkg:gem/activeagent#lib/active_agent/providers/concerns/instrumentation.rb:137
  def safe_access(obj, name); end
end

# Logs provider operations via ActiveSupport::Notifications events.
#
# Subscribes to instrumented provider events and formats them consistently.
# Customize by subclassing and attaching your subscriber, or adjust log levels.
#
# @example Custom log formatting
#   class MyLogSubscriber < ActiveAgent::Providers::LogSubscriber
#     def prompt(event)
#       info "🚀 #{event.payload[:provider_module]}: #{event.duration}ms"
#     end
#   end
#
#   ActiveAgent::Providers::LogSubscriber.detach_from :active_agent
#   MyLogSubscriber.attach_to :active_agent
#
# pkg:gem/activeagent#lib/active_agent/providers/log_subscriber.rb:21
class ActiveAgent::Providers::LogSubscriber < ::ActiveSupport::LogSubscriber
  # Logs connection failures with service URI and error details.
  #
  # @param event [ActiveSupport::Notifications::Event]
  # @return [void]
  #
  # pkg:gem/activeagent#lib/active_agent/providers/log_subscriber.rb:146
  def connection_error(event); end

  # Logs completed embedding with model, input size, and token usage.
  #
  # @param event [ActiveSupport::Notifications::Event]
  # @return [void]
  #
  # pkg:gem/activeagent#lib/active_agent/providers/log_subscriber.rb:64
  def embed(event); end

  # Logs completed prompt with model, message count, token usage, and duration.
  #
  # @param event [ActiveSupport::Notifications::Event]
  # @return [void]
  #
  # pkg:gem/activeagent#lib/active_agent/providers/log_subscriber.rb:28
  def prompt(event); end

  # @param event [ActiveSupport::Notifications::Event]
  # @return [void]
  #
  # pkg:gem/activeagent#lib/active_agent/providers/log_subscriber.rb:127
  def stream_chunk(event); end

  # @param event [ActiveSupport::Notifications::Event]
  # @return [void]
  #
  # pkg:gem/activeagent#lib/active_agent/providers/log_subscriber.rb:101
  def stream_close(event); end

  # @param event [ActiveSupport::Notifications::Event]
  # @return [void]
  #
  # pkg:gem/activeagent#lib/active_agent/providers/log_subscriber.rb:89
  def stream_open(event); end

  # @param event [ActiveSupport::Notifications::Event]
  # @return [void]
  #
  # pkg:gem/activeagent#lib/active_agent/providers/log_subscriber.rb:113
  def tool_call(event); end

  private

  # @return [Logger]
  #
  # pkg:gem/activeagent#lib/active_agent/providers/log_subscriber.rb:162
  def logger; end
end

# Generates markdown previews of prompts for debugging and inspection.
#
# Renders request parameters, instructions, messages, and tools in a
# human-readable format without executing the actual API call.
#
# pkg:gem/activeagent#lib/active_agent/providers/concerns/previewable.rb:9
module ActiveAgent::Providers::Previewable
  extend ::ActiveSupport::Concern

  # Generates a markdown preview of the prompt request.
  #
  # @return [String] markdown-formatted preview
  #
  # pkg:gem/activeagent#lib/active_agent/providers/concerns/previewable.rb:15
  def preview_prompt; end

  private

  # Extracts text content from various message formats.
  #
  # Handles string messages, hash messages with :content key, and
  # array content blocks (extracting only text-type blocks).
  #
  # @param message [Hash, String, nil]
  # @return [String]
  #
  # pkg:gem/activeagent#lib/active_agent/providers/concerns/previewable.rb:151
  def extract_message_content(message); end

  # Extracts tool details from different formats.
  #
  # @param tool [Hash]
  # @return [Array<String, String, Hash>] [name, description, parameters]
  #
  # pkg:gem/activeagent#lib/active_agent/providers/concerns/previewable.rb:123
  def extract_tool_details(tool); end

  # @param instructions [String]
  # @return [String]
  #
  # pkg:gem/activeagent#lib/active_agent/providers/concerns/previewable.rb:58
  def render_instructions_section(instructions); end

  # Renders markdown preview with YAML metadata, instructions, messages, and tools.
