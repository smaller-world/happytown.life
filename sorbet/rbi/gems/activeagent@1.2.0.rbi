# Telemetry module for collecting and reporting agent traces.
#
# Provides optional observability by capturing agent generation traces,
# tool calls, token usage, and errors. Reports to a configured endpoint
# (self-hosted or ActiveAgents.ai hosted service).
#
# = Features
#
# * **Trace Collection**: Captures full generation lifecycle with spans
# * **Token Tracking**: Records input/output/thinking tokens per generation
# * **Tool Call Tracing**: Captures tool invocations with arguments and results
# * **Error Tracking**: Records errors with backtraces
# * **Async Reporting**: Non-blocking HTTP reporting with background thread
#
# = Configuration
#
# Configure in your Rails initializer or activeagent.yml:
#
# @example Basic configuration
#   ActiveAgent::Telemetry.configure do |config|
#     config.enabled = true
#     config.endpoint = "https://api.activeagents.ai/v1/traces"
#     config.api_key = Rails.application.credentials.dig(:activeagents, :api_key)
#   end
#
# @example YAML configuration (config/activeagent.yml)
#   telemetry:
#     enabled: true
#     endpoint: https://api.activeagents.ai/v1/traces
#     api_key: <%= Rails.application.credentials.dig(:activeagents, :api_key) %>
#     sample_rate: 1.0
#     batch_size: 100
#     flush_interval: 5
#
# @example Self-hosted endpoint
#   ActiveAgent::Telemetry.configure do |config|
#     config.endpoint = "https://observability.mycompany.com/v1/traces"
#     config.api_key = ENV["TELEMETRY_API_KEY"]
#   end
#
# @see ActiveAgent::Telemetry::Configuration
# @see ActiveAgent::Telemetry::Tracer
#
# pkg:gem/activeagent#lib/active_agent/telemetry.rb:49
module ActiveAgent::Telemetry
  extend ::ActiveSupport::Autoload

  class << self
    # Returns the telemetry configuration instance.
    #
    # @return [Configuration] The configuration instance
    #
    # pkg:gem/activeagent#lib/active_agent/telemetry.rb:63
    def configuration; end

    # Configures telemetry with a block.
    #
    # @yield [config] Yields the configuration instance
    # @yieldparam config [Configuration] The configuration to modify
    # @return [Configuration] The modified configuration
    #
    # @example
    #   ActiveAgent::Telemetry.configure do |config|
    #     config.enabled = true
    #     config.endpoint = "https://api.activeagents.ai/v1/traces"
    #     config.api_key = "your-api-key"
    #   end
    #
    # pkg:gem/activeagent#lib/active_agent/telemetry.rb:79
    def configure; end

    # Returns whether telemetry is enabled and configured.
    #
    # @return [Boolean] True if telemetry should collect and report
    #
    # pkg:gem/activeagent#lib/active_agent/telemetry.rb:94
    def enabled?; end

    # Flushes any buffered traces immediately.
    #
    # @return [void]
    #
    # pkg:gem/activeagent#lib/active_agent/telemetry.rb:137
    def flush; end

    # Resets the configuration to defaults.
    #
    # @return [Configuration] New default configuration
    #
    # pkg:gem/activeagent#lib/active_agent/telemetry.rb:87
    def reset_configuration!; end

    # Shuts down telemetry, flushing remaining traces.
    #
    # @return [void]
    #
    # pkg:gem/activeagent#lib/active_agent/telemetry.rb:144
    def shutdown; end

    # Records a standalone span (outside of a trace context).
    #
    # @param name [String] Span name
    # @param attributes [Hash] Span attributes
    # @return [Span] The created span
    #
    # pkg:gem/activeagent#lib/active_agent/telemetry.rb:128
    def span(name, **attributes); end

    # Starts a new trace for an agent generation.
    #
    # @param name [String] Name of the trace (typically agent.action)
    # @param attributes [Hash] Additional trace attributes
    # @yield [trace] Yields the trace for adding spans
    # @return [Span] The root span of the trace
    #
    # @example
    #   ActiveAgent::Telemetry.trace("WeatherAgent.forecast") do |trace|
    #     trace.add_span("llm.generate", provider: "anthropic")
    #     trace.set_tokens(input: 100, output: 50)
    #   end
    #
    # pkg:gem/activeagent#lib/active_agent/telemetry.rb:117
    def trace(name, **attributes, &block); end

    # Returns the global tracer instance.
    #
    # @return [Tracer] The tracer instance
    #
    # pkg:gem/activeagent#lib/active_agent/telemetry.rb:101
    def tracer; end
  end
end

# The framework's telemetry configuration, now provided by the
# activeagents-telemetry gem. This subclass keeps the framework's
# historical behavior on top of the shared core:
#
# * telemetry is opt-in (`enabled` defaults to false)
# * `local_storage: true` persists traces through the dashboard's trace
#   model instead of HTTP
#
# Every other option — endpoint, api_key, sample_rate, batch_size,
# flush_interval, capture_bodies, redact_attributes, service_name,
# environment, resource_attributes — lives on the shared class, so
# existing config/active_agent.yml files keep working unchanged.
#
# @see ActiveAgents::Telemetry::Configuration
#
# pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:19
class ActiveAgent::Telemetry::Configuration < ::ActiveAgents::Telemetry::Configuration
  # pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:27
  def initialize; end

  # The dashboard engine's ingest path, derived from wherever the host
  # app actually mounted it — "/activeagents", "/observability", or "/"
  # on a dedicated subdomain all work. Falls back to
  # LOCAL_ENDPOINT_PATH when the engine isn't mounted.
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:62
  def local_endpoint_path; end

  # @return [Boolean] Whether to store traces in the app's own database
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:25
  def local_storage; end

  # pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:35
  def local_storage=(value); end

  # pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:39
  def local_storage?; end

  # When local storage is on, traces persist through the dashboard's
  # trace model rather than leaving the process.
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:49
  def local_store; end

  # pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:43
  def local_store?; end

  # The engine's mount path within a given route set, or nil when it
  # isn't mounted there. Separate from #dashboard_mount_path so it can be
  # exercised against a route set directly.
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:130
  def mount_path_in(route_set); end

  # Returns the resolved endpoint for trace reporting.
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:54
  def resolved_endpoint; end

  # The framework's historical fallback is "activeagent", not the shared
  # core's generic "ruby".
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:69
  def resolved_service_name; end

  # pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:74
  def to_h; end

  private

  # The engine's mount point in the host app, found by locating the
  # mounted engine in the host's route set. Works regardless of the
  # helper name, so `mount ... => "/", as: :something_else` and
  # constraint-wrapped mounts resolve correctly. Returns nil when the
  # engine isn't mounted or no Rails app is booted; "" for a root mount.
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:119
  def dashboard_mount_path; end

  # Persists a trace through the dashboard's trace model, honoring
  # ActionAgent.trace_model_class overrides. Idempotent on trace_id, as
  # HTTP ingest is.
  #
  # The dashboard is the `actionagent` gem, which the framework does not
  # depend on — every reference to it here is guarded, so local_storage
  # simply reports that it has nowhere to write when it isn't installed.
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:87
  def dashboard_store; end

  # pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:104
  def local_trace_model; end

  # Unwraps the constraint layers Rails wraps a mounted engine in,
  # returning the engine class (or nil for ordinary routes). Stops at the
  # engine class itself — engines also respond to #app (their route set),
  # so unwrapping blindly walks straight past them.
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:146
  def mounted_engine(app); end
end

# Fallback ingest path when the dashboard engine's mount point can't
# be resolved from the host's routes (e.g. engine not mounted).
#
# pkg:gem/activeagent#lib/active_agent/telemetry/configuration.rb:22
ActiveAgent::Telemetry::Configuration::LOCAL_ENDPOINT_PATH = T.let(T.unsafe(nil), String)

# Auto-instrumentation for ActiveAgent generation lifecycle.
#
# When included in ActiveAgent::Base, automatically traces:
# - Agent generation (prompt_now, generate_now)
# - Tool calls
# - Streaming events
# - Errors
#
# @example Enabling instrumentation
#   # In config/initializers/activeagent.rb
#   ActiveAgent::Telemetry.configure do |config|
#     config.enabled = true
#     config.endpoint = "https://api.activeagents.ai/v1/traces"
#     config.api_key = Rails.application.credentials.activeagents_api_key
#   end
#
#   # Instrumentation is automatically applied when telemetry is enabled
#
# pkg:gem/activeagent#lib/active_agent/telemetry/instrumentation.rb:23
module ActiveAgent::Telemetry::Instrumentation
  extend ::ActiveSupport::Concern

  mixes_in_class_methods ::ActiveAgent::Telemetry::Instrumentation::ClassMethods
end

# pkg:gem/activeagent#lib/active_agent/telemetry/instrumentation.rb:26
module ActiveAgent::Telemetry::Instrumentation::ClassMethods
  # pkg:gem/activeagent#lib/active_agent/telemetry/instrumentation.rb:30
  def instrument_telemetry!; end
end

# Module prepended to intercept generation methods.
#
# pkg:gem/activeagent#lib/active_agent/telemetry/instrumentation.rb:39
module ActiveAgent::Telemetry::Instrumentation::GenerationInstrumentation
  # Wraps process_embed with telemetry tracing.
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/instrumentation.rb:228
  def process_embed; end

  # Wraps process_prompt with telemetry tracing.
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/instrumentation.rb:41
  def process_prompt; end

  # Providers invoke this proc for every tool call during generation.
  # Wrapping it is what makes tool telemetry real: each call gets a
  # timed span with its arguments and result — the post-hoc
  # result.tool_calls path below never fires on 1.x responses, which
  # don't expose tool calls.
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/instrumentation.rb:193
  def tools_function; end

  private

  # pkg:gem/activeagent#lib/active_agent/telemetry/instrumentation.rb:274
  def model_name; end

  # pkg:gem/activeagent#lib/active_agent/telemetry/instrumentation.rb:267
  def provider_name; end

  # pkg:gem/activeagent#lib/active_agent/telemetry/instrumentation.rb:260
  def telemetry_truncate(value); end
end

# Content attributes are capped so a large prompt (e.g. a 100k-token
# tool loop) can't bloat the trace payload.
#
# pkg:gem/activeagent#lib/active_agent/telemetry/instrumentation.rb:258
ActiveAgent::Telemetry::Instrumentation::GenerationInstrumentation::TELEMETRY_ATTRIBUTE_MAX_CHARS = T.let(T.unsafe(nil), Integer)

# Null span implementation for when telemetry is disabled.
#
# Provides no-op methods that match Span interface to avoid
# nil checks throughout the codebase.
#
# pkg:gem/activeagent#lib/active_agent/telemetry.rb:153
class ActiveAgent::Telemetry::NullSpan
  # pkg:gem/activeagent#lib/active_agent/telemetry.rb:154
  def add_span(name, **attributes); end

  # pkg:gem/activeagent#lib/active_agent/telemetry.rb:159
  def finish; end

  # pkg:gem/activeagent#lib/active_agent/telemetry.rb:158
  def record_error(error); end

  # pkg:gem/activeagent#lib/active_agent/telemetry.rb:155
  def set_attribute(key, value); end

  # pkg:gem/activeagent#lib/active_agent/telemetry.rb:157
  def set_status(status, message = T.unsafe(nil)); end

  # pkg:gem/activeagent#lib/active_agent/telemetry.rb:156
  def set_tokens(input: T.unsafe(nil), output: T.unsafe(nil), thinking: T.unsafe(nil)); end
end

# The framework's reporter, now provided by the activeagents-telemetry
# gem's BatchingReporter: buffered delivery on batch_size/flush_interval,
# a blocking flush, and a shutdown that waits out in-flight sends so
# traces reported near process exit are delivered rather than dropped.
#
# Local storage is handled by Configuration#local_store, which routes
# traces through the dashboard's trace model instead of HTTP.
#
# @see ActiveAgents::Telemetry::BatchingReporter
#
# pkg:gem/activeagent#lib/active_agent/telemetry/reporter.rb:14
class ActiveAgent::Telemetry::Reporter < ::ActiveAgents::Telemetry::BatchingReporter
  # pkg:gem/activeagent#lib/active_agent/telemetry/reporter.rb:15
  def initialize(configuration); end
end

# The framework's span, now provided by the activeagents-telemetry gem.
# This subclass translates the framework's historical constructor
# (span_type: keyword, attributes as a keyword splat) onto the shared
# class; everything else — set_attribute, set_tokens, set_status,
# record_error, add_span, measure, finish — is inherited.
#
# One deliberate change rides along from the shared core: record_error
# truncates the message and no longer puts a backtrace on the wire.
#
# @see ActiveAgents::Telemetry::Span
#
# pkg:gem/activeagent#lib/active_agent/telemetry/span.rb:15
class ActiveAgent::Telemetry::Span < ::ActiveAgents::Telemetry::Span
  # pkg:gem/activeagent#lib/active_agent/telemetry/span.rb:16
  def initialize(name, trace_id:, parent_span_id: T.unsafe(nil), span_type: T.unsafe(nil), **attributes); end

  # Creates a child span, keeping the framework's keyword shape.
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/span.rb:27
  def add_span(name, span_type: T.unsafe(nil), **attributes); end
end

# Classifies where a tool call came from, so dashboards can group tool
# traffic by the service that serves it instead of showing a flat list
# of names.
#
# Telemetry only ever sees the name a provider used to invoke the tool,
# so the origin has to be recovered from naming conventions. The MCP
# ecosystem settled on a namespaced form — +mcp__<server>__<tool>+ —
# which most clients (Claude Code, Cursor, the Ruby MCP clients) emit
# verbatim, and that is the strongest signal available. Everything else
# falls back to "the agent class defines this method".
#
# Classification happens at instrumentation time rather than at read
# time so the attribution is recorded in the span itself: a trace stays
# self-describing, and consumers (the gem dashboard, activeagents.ai,
# any OTLP exporter) all read the same fields instead of each
# re-implementing the guess.
#
# @example Namespaced MCP tool
#   ToolOrigin.classify("mcp__playwright__browser_navigate")
#   # => { origin: "mcp", server: "playwright", tool: "browser_navigate" }
#
# @example Agent-defined method
#   ToolOrigin.classify("lookup_order")
#   # => { origin: "agent", server: nil, tool: "lookup_order" }
#
# pkg:gem/activeagent#lib/active_agent/telemetry/tool_origin.rb:29
module ActiveAgent::Telemetry::ToolOrigin
  private

  # Writes the classification onto a span. Only sets +tool.mcp_server+
  # when there is a server to name, so agent-defined tools don't carry
  # an empty attribute.
  #
  # @param span [ActiveAgent::Telemetry::Span]
  # @param name [String, Symbol] the tool name
  # @return [Hash] the classification, for callers that also want it
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/tool_origin.rb:79
  def annotate(span, name); end

  # Classifies a tool name.
  #
  # @param name [String, Symbol] the tool name as the provider invoked it
  # @return [Hash] +:origin+ ("mcp" or "agent"), +:server+ (MCP server
  #   name or nil), and +:tool+ (the bare tool name with any namespace
  #   stripped)
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/tool_origin.rb:46
  def classify(name); end

  # Whether a tool name is namespaced to an MCP server.
  #
  # @param name [String, Symbol]
  # @return [Boolean]
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/tool_origin.rb:60
  def mcp?(name); end

  # The MCP server a tool belongs to, if any.
  #
  # @param name [String, Symbol]
  # @return [String, nil]
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/tool_origin.rb:68
  def server_for(name); end

  class << self
    # Writes the classification onto a span. Only sets +tool.mcp_server+
    # when there is a server to name, so agent-defined tools don't carry
    # an empty attribute.
    #
    # @param span [ActiveAgent::Telemetry::Span]
    # @param name [String, Symbol] the tool name
    # @return [Hash] the classification, for callers that also want it
    #
    # pkg:gem/activeagent#lib/active_agent/telemetry/tool_origin.rb:79
    def annotate(span, name); end

    # Classifies a tool name.
    #
    # @param name [String, Symbol] the tool name as the provider invoked it
    # @return [Hash] +:origin+ ("mcp" or "agent"), +:server+ (MCP server
    #   name or nil), and +:tool+ (the bare tool name with any namespace
    #   stripped)
    #
    # pkg:gem/activeagent#lib/active_agent/telemetry/tool_origin.rb:46
    def classify(name); end

    # Whether a tool name is namespaced to an MCP server.
    #
    # @param name [String, Symbol]
    # @return [Boolean]
    #
    # pkg:gem/activeagent#lib/active_agent/telemetry/tool_origin.rb:60
    def mcp?(name); end

    # The MCP server a tool belongs to, if any.
    #
    # @param name [String, Symbol]
    # @return [String, nil]
    #
    # pkg:gem/activeagent#lib/active_agent/telemetry/tool_origin.rb:68
    def server_for(name); end
  end
end

# pkg:gem/activeagent#lib/active_agent/telemetry/tool_origin.rb:36
ActiveAgent::Telemetry::ToolOrigin::AGENT = T.let(T.unsafe(nil), String)

# Origin values written to +tool.origin+.
#
# pkg:gem/activeagent#lib/active_agent/telemetry/tool_origin.rb:35
ActiveAgent::Telemetry::ToolOrigin::MCP = T.let(T.unsafe(nil), String)

# +mcp__<server>__<tool>+. The tool half may itself contain "__", so
# only the first two segments are structural.
#
# pkg:gem/activeagent#lib/active_agent/telemetry/tool_origin.rb:32
ActiveAgent::Telemetry::ToolOrigin::MCP_PATTERN = T.let(T.unsafe(nil), Regexp)

# Manages trace creation and lifecycle on the activeagents-telemetry
# core: builds an ActiveAgents::Telemetry::Trace per unit of work, tracks
# the current span in thread-local storage, and hands finished traces to
# the Reporter.
#
# @example
#   tracer = Tracer.new(configuration)
#   tracer.trace("MyAgent.greet") do |span|
#     span.set_attribute("user_id", 123)
#     span.add_span("llm.generate", span_type: :llm)
#   end
#
# pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:16
class ActiveAgent::Telemetry::Tracer
  # pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:26
  def initialize(configuration); end

  # @return [Configuration] Telemetry configuration
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:18
  def configuration; end

  # Returns the current span from thread-local storage.
  #
  # @return [Span, nil] Current span or nil
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:93
  def current_span; end

  # Flushes buffered traces and waits for delivery to complete, so
  # callers (tests, rails runner, job shutdown) can rely on the traces
  # having been delivered/stored when this returns.
  #
  # @return [void]
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:102
  def flush; end

  # @return [Reporter] The reporter for sending traces
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:21
  def reporter; end

  # Shuts down the tracer and reporter.
  #
  # @return [void]
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:109
  def shutdown; end

  # Creates a standalone span (not within a trace block).
  #
  # @param name [String] Span name
  # @param attributes [Hash] Span attributes
  # @return [Span] The created span
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:78
  def span(name, **attributes); end

  # Creates and executes a new trace.
  #
  # Callers may supply the trace id (instrumentation passes the
  # generation's prompt_options[:trace_id]) so external records — e.g.
  # solid_agent's persisted generations — can correlate with this trace;
  # otherwise one is generated.
  #
  # @param name [String] Trace name (typically "AgentClass.action")
  # @param attributes [Hash] Root span attributes; :trace_id and
  #   :span_type are extracted rather than recorded
  # @yield [span] Yields the root span for adding child spans
  # @return [Object] Result of the block
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:43
  def trace(name, **attributes); end

  private

  # pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:115
  def build_trace(trace_id); end

  # Returns default attributes for all spans.
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:171
  def default_attributes; end

  # pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:159
  def redact_hash!(attributes, matcher); end

  # pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:150
  def redact_span!(span, matcher); end

  # pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:141
  def redact_trace!(trace); end

  # Returns whether this trace should be collected at all.
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:166
  def should_trace?; end

  # Executes block with span as current context.
  #
  # pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:125
  def with_span(span); end
end

# Thread-local storage for current trace context
#
# pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:24
ActiveAgent::Telemetry::Tracer::CURRENT_SPAN_KEY = T.let(T.unsafe(nil), Symbol)

# Redacts span (and span-event) attributes whose keys match any
# configured redact_attributes entry, before the trace is handed to
# the reporter. Matching is case-insensitive substring — deliberately
# over-broad: better to redact a harmless "max_tokens" than to ship
# an "api_key". (Ported from the pre-shared-core payload builder,
# which no longer exists — the gem's reporter ships the trace as-is.)
#
# pkg:gem/activeagent#lib/active_agent/telemetry/tracer.rb:139
ActiveAgent::Telemetry::Tracer::REDACTED = T.let(T.unsafe(nil), String)

# Provides tool/function calling support for agent classes.
#
# Enables agent classes to respond to tool calls from providers
# by routing them to the appropriate action methods.
#
# pkg:gem/activeagent#lib/active_agent/concerns/tooling.rb:8
module ActiveAgent::Tooling
  extend ::ActiveSupport::Concern

  # Returns a proc that handles tool/function calls from providers.
  #
  # The proc routes tool calls to the appropriate action method using
  # the {#process} method.
  #
  # @return [Proc] callback proc that accepts (action_name, *args, **kwargs)
  #
  # pkg:gem/activeagent#lib/active_agent/concerns/tooling.rb:17
  def tools_function; end
end

# pkg:gem/activeagent#lib/active_agent/version.rb:2
ActiveAgent::VERSION = T.let(T.unsafe(nil), String)

# Provides template lookup and rendering for agent classes.
#
# Enables agents to render instructions, schemas, and messages from
# ERB templates with flexible directory structures and fallback paths.
#
# pkg:gem/activeagent#lib/active_agent/concerns/view.rb:8
module ActiveAgent::View
  extend ::ActiveSupport::Concern
  include GeneratedInstanceMethods
  include ::ActionView::ViewPaths
  include ::ActionView::Rendering
  include ::ActionView::Layouts

  mixes_in_class_methods GeneratedClassMethods
  mixes_in_class_methods ::ActionView::ViewPaths::ClassMethods
  mixes_in_class_methods ::ActionView::Rendering::ClassMethods
  mixes_in_class_methods ::ActionView::Layouts::ClassMethods

  # Builds template lookup paths supporting both flat and nested directory structures.
  #
  # Templates are searched in priority order:
  # - `app/views/{agent_name}/` (e.g., `app/views/support_agent/`)
  # - `app/views/agents/{agent_without_suffix}/` (e.g., `app/views/agents/support/`)
  #
  # With action_name present:
  # - `app/views/agents/{agent_without_suffix}/{action_name}/`
  # - `app/views/{agent_name}/{action_name}/`
  # - `app/views/{agent_name}/`
  # - `app/views/agents/{agent_without_suffix}/`
  #
  # @return [Array<String>] ordered prefixes for template lookup
  #
  # pkg:gem/activeagent#lib/active_agent/concerns/view.rb:28
  def _prefixes; end

  # Renders template for embedding input.
  #
  # @param action_name [String, Symbol]
  # @param locals [Hash]
  # @return [String, nil]
  #
  # pkg:gem/activeagent#lib/active_agent/concerns/view.rb:121
  def embed_view_input(action_name, **locals); end

  # Prepares instructions from various input formats.
  #
  # Supported formats:
  # - `String`: returned as-is
  # - `Symbol`: invokes method with that name (like ActiveRecord callbacks)
  # - `Array<String>`: returned as-is if all elements are strings
  # - `Hash`: requires `:template` key, optional `:locals`
  # - `nil` or `true`: renders default "instructions" template
  #
  # @param value [Hash, String, Symbol, Array<String>, Boolean, nil]
  # @return [String, Array<String>, nil] nil if template not found
  # @raise [ArgumentError] if format is invalid or Hash missing :template key
  #
  # pkg:gem/activeagent#lib/active_agent/concerns/view.rb:62
  def prompt_view_instructions(value); end

  # Renders template for a prompt action or message.
  #
  # @param action_name [String, Symbol]
  # @param locals [Hash]
  # @return [String, nil]
  #
  # pkg:gem/activeagent#lib/active_agent/concerns/view.rb:92
  def prompt_view_message(action_name, strict:, **locals); end

  # Renders JSON schema from template or returns Hash directly.
  #
  # Schema templates are looked up as `{name}.json`:
  # - When value is `true` or `nil`: looks for `{action_name}.json`
  # - When value is a String/Symbol: looks for `{value}.json`
  # - When value is a Hash: returns the Hash directly
  #
  # @param value [Hash, String, Symbol, Boolean, nil]
  # @return [Hash, String, nil]
  #
  # pkg:gem/activeagent#lib/active_agent/concerns/view.rb:105
  def prompt_view_schema(value); end

  private

  # Renders a template if it exists in any supported ERB format.
  #
  # Templates are looked up using the prefixes defined in `_prefixes`:
  # 1. `app/views/{agent_name}/` (e.g., `app/views/statements_agent/`)
  # 2. `app/views/agents/{agent_without_suffix}/` (e.g., `app/views/agents/statements/`)
  #
  # @param template_name [String, Symbol] template file name without extension
  # @param strict [Boolean] if true, raises error when template not found
  # @param format [Symbol, nil] specific format to look for (e.g., :json, :html)
  # @param locals [Hash] local variables passed to template
  # @return [String, nil] nil if template not found and not strict
  #
  # pkg:gem/activeagent#lib/active_agent/concerns/view.rb:140
  def view_render_template(template_name, strict: T.unsafe(nil), formats: T.unsafe(nil), **locals); end

  module GeneratedClassMethods
    def _layout; end
    def _layout=(value); end
    def _layout?; end
    def _layout_conditions; end
    def _layout_conditions=(value); end
    def _layout_conditions?; end
  end

  module GeneratedInstanceMethods
    def _layout_conditions; end
    def _layout_conditions?; end
  end
end

# @private
#
# pkg:gem/activeagent#lib/active_agent/providers/_base_provider.rb:10
GEM_LOADERS = T.let(T.unsafe(nil), Hash)

class Object < ::BasicObject
  include ::Kernel
  include ::PP::ObjectMixin

  private

  # Requires a provider's gem dependency.
  #
  # @param type [Symbol] provider type (:anthropic, :openai)
  # @param file_name [String] for error context
  # @return [void]
  # @raise [LoadError] when required gem is not installed
  #
  # pkg:gem/activeagent#lib/active_agent/providers/_base_provider.rb:22
  def require_gem!(type, file_name); end
end
